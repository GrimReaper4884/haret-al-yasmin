# Wally (regenerated by `wally install`)
/Packages/
/DevPackages/
/ServerPackages/
wally.lock.bak

# Rojo / tooling output
/build/
sourcemap.json
*.rbxl.lock
*.rbxlx.lock

# Place-file backups: large binaries. Keep them out of git unless Git LFS is set up (BUILD_PLAN U0-3).
/places/*.rbxl
/places/*.rbxlx

# Blender
*.blend1
*.blend2
/assets/export/tmp/

# Secrets: Open Cloud keys, provider keys. Never commit these.
.env
.env.*
*.key
*api_key*

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
