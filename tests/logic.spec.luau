--!nocheck
-- Wallet, Inventory, QuestLogic, ShopLogic, DialogueLogic, RateLimiter, Validate.

return function(t)
	local Wallet = t.logic("Wallet")
	local Inventory = t.logic("Inventory")
	local QuestLogic = t.logic("QuestLogic")
	local ShopLogic = t.logic("ShopLogic")
	local DialogueLogic = t.logic("DialogueLogic")
	local RateLimiter = t.logic("RateLimiter")
	local Validate = t.logic("Validate")
	local Items = t.config("Items")
	local Quests = t.config("Quests")
	local Shops = t.config("Shops")
	local Dialogue = t.config("Dialogue")
	local Economy = t.config("Economy")

	local function profile(over)
		local p = { qirsh = 0, inventory = {}, equipped = {}, quests = {} }
		for k, v in pairs(over or {}) do
			p[k] = v
		end
		return p
	end

	t.describe("Wallet", function()
		t.it("adds and spends integers", function()
			local p = profile()
			t.truthy(Wallet.add(p, 50, 1000))
			t.truthy(Wallet.spend(p, 20))
			t.eq(p.qirsh, 30)
		end)
		t.it("rejects overspending without changing balance", function()
			local p = profile({ qirsh = 10 })
			local ok, err = Wallet.spend(p, 11)
			t.eq(ok, false)
			t.eq(err, "insufficient_funds")
			t.eq(p.qirsh, 10)
		end)
		t.it("rejects negative, fractional, NaN and infinite amounts", function()
			local p = profile({ qirsh = 100 })
			for _, bad in { -1, 1.5, 0 / 0, math.huge, "5" } do
				t.eq(Wallet.add(p, bad, 1000), false, "add " .. tostring(bad))
				t.eq(Wallet.spend(p, bad), false, "spend " .. tostring(bad))
			end
			t.eq(p.qirsh, 100)
		end)
		t.it("clamps to the maximum and reports what was added", function()
			local p = profile({ qirsh = 990 })
			local ok, _, added = Wallet.add(p, 50, 1000)
			t.truthy(ok)
			t.eq(p.qirsh, 1000)
			t.eq(added, 10)
		end)
	end)

	t.describe("Inventory", function()
		t.it("respects stackMax", function()
			local p = profile()
			t.truthy(Inventory.add(p, "basket_kaak", 1, Items))
			local ok, err = Inventory.add(p, "basket_kaak", 1, Items)
			t.eq(ok, false)
			t.eq(err, "stack_full")
			t.eq(Inventory.count(p, "basket_kaak"), 1)
		end)
		t.it("rejects unknown items", function()
			local ok, err = Inventory.add(profile(), "golden_camel", 1, Items)
			t.eq(ok, false)
			t.eq(err, "unknown_item")
		end)
		t.it("removes and clears empty stacks", function()
			local p = profile({ inventory = { basket_kaak = 1 } })
			t.truthy(Inventory.remove(p, "basket_kaak", 1))
			t.eq(p.inventory.basket_kaak, nil)
			t.eq(Inventory.remove(p, "basket_kaak", 1), false)
		end)
	end)

	t.describe("QuestLogic: delivery_kaak", function()
		t.it("full happy path pays exactly once", function()
			local p = profile()
			t.eq(QuestLogic.state(p, "delivery_kaak"), "none")
			t.truthy(QuestLogic.accept(p, "delivery_kaak", Quests, Items, 100))
			t.eq(QuestLogic.state(p, "delivery_kaak"), "active")
			t.eq(Inventory.count(p, "basket_kaak"), 1)

			local ok, err, paid = QuestLogic.deliver(p, "delivery_kaak", Quests, Economy.MAX_QIRSH, 200)
			t.truthy(ok, err)
			t.eq(paid, 50)
			t.eq(p.qirsh, 50)
			t.eq(Inventory.count(p, "basket_kaak"), 0)
			t.eq(QuestLogic.state(p, "delivery_kaak"), "completed")
			t.eq(p.quests.delivery_kaak.completions, 1)

			-- Replays / double submits
			local ok2, err2 = QuestLogic.deliver(p, "delivery_kaak", Quests, Economy.MAX_QIRSH, 300)
			t.eq(ok2, false)
			t.eq(err2, "not_active")
			local ok3, err3 = QuestLogic.accept(p, "delivery_kaak", Quests, Items, 300)
			t.eq(ok3, false)
			t.eq(err3, "already_completed")
			t.eq(p.qirsh, 50)
		end)
		t.it("cannot deliver without accepting", function()
			local p = profile()
			local ok, err = QuestLogic.deliver(p, "delivery_kaak", Quests, Economy.MAX_QIRSH, 1)
			t.eq(ok, false)
			t.eq(err, "not_active")
			t.eq(p.qirsh, 0)
		end)
		t.it("cannot accept twice", function()
			local p = profile()
			t.truthy(QuestLogic.accept(p, "delivery_kaak", Quests, Items, 1))
			local ok, err = QuestLogic.accept(p, "delivery_kaak", Quests, Items, 2)
			t.eq(ok, false)
			t.eq(err, "already_active")
			t.eq(Inventory.count(p, "basket_kaak"), 1)
		end)
		t.it("cannot deliver if the item is missing (and nothing changes)", function()
			local p = profile()
			QuestLogic.accept(p, "delivery_kaak", Quests, Items, 1)
			p.inventory.basket_kaak = nil
			local before = t.deepCopy(p)
			local ok, err = QuestLogic.deliver(p, "delivery_kaak", Quests, Economy.MAX_QIRSH, 2)
			t.eq(ok, false)
			t.eq(err, "missing_item")
			t.truthy(t.deepEq(p, before), "profile modified on failure")
		end)
		t.it("failed accept leaves profile untouched when the item slot is full", function()
			local p = profile({ inventory = { basket_kaak = 1 } })
			local before = t.deepCopy(p)
			local ok, err = QuestLogic.accept(p, "delivery_kaak", Quests, Items, 1)
			t.eq(ok, false)
			t.eq(err, "stack_full")
			t.truthy(t.deepEq(p, before))
		end)
		t.it("unknown quest is rejected", function()
			t.eq(QuestLogic.accept(profile(), "nope", Quests, Items, 1), false)
		end)
	end)

	t.describe("ShopLogic", function()
		local shop = Shops.khalil_tailor
		t.it("buys the tarboosh at the configured price", function()
			local p = profile({ qirsh = 50 })
			local ok, err, price = ShopLogic.purchase(p, shop, "tarboosh_red", Items)
			t.truthy(ok, err)
			t.eq(price, 40)
			t.eq(p.qirsh, 10)
			t.eq(Inventory.count(p, "tarboosh_red"), 1)
		end)
		t.it("refuses when funds are short, without side effects", function()
			local p = profile({ qirsh = 39 })
			local before = t.deepCopy(p)
			local ok, err = ShopLogic.purchase(p, shop, "tarboosh_red", Items)
			t.eq(ok, false)
			t.eq(err, "insufficient_funds")
			t.truthy(t.deepEq(p, before))
		end)
		t.it("refuses buying an owned cosmetic twice", function()
			local p = profile({ qirsh = 200, inventory = { tarboosh_red = 1 } })
			local ok, err = ShopLogic.purchase(p, shop, "tarboosh_red", Items)
			t.eq(ok, false)
			t.eq(err, "already_owned")
			t.eq(p.qirsh, 200)
		end)
		t.it("refuses items the shop does not sell or that are not for sale", function()
			local p = profile({ qirsh = 999 })
			t.eq(ShopLogic.purchase(p, shop, "basket_kaak", Items), false)
			t.eq(ShopLogic.purchase(p, nil, "tarboosh_red", Items), false)
			t.eq(ShopLogic.purchase(p, shop, "missing", Items), false)
			t.eq(p.qirsh, 999)
		end)
		t.it("wears only owned cosmetics and takes them off", function()
			local p = profile()
			t.eq(ShopLogic.setWorn(p, "tarboosh_red", true, Items), false)
			p.inventory.tarboosh_red = 1
			t.truthy(ShopLogic.setWorn(p, "tarboosh_red", true, Items))
			t.eq(p.equipped.head, "tarboosh_red")
			t.truthy(ShopLogic.setWorn(p, "tarboosh_red", false, Items))
			t.eq(p.equipped.head, nil)
			t.eq(ShopLogic.setWorn(p, "basket_kaak", true, Items), false)
		end)
	end)

	t.describe("DialogueLogic", function()
		t.it("picks Abu Nadim's node from quest state", function()
			local p = profile()
			t.eq(DialogueLogic.entryNode(Dialogue.abu_nadim, p), "offer")
			p.quests.delivery_kaak = { state = "active" }
			t.eq(DialogueLogic.entryNode(Dialogue.abu_nadim, p), "waiting")
			p.quests.delivery_kaak.state = "completed"
			t.eq(DialogueLogic.entryNode(Dialogue.abu_nadim, p), "thanks")
		end)
		t.it("falls back to an unconditional entry", function()
			t.eq(DialogueLogic.entryNode(Dialogue.sitt_wardeh, profile()), "greet")
		end)
		t.it("rejects forged choice indices", function()
			for _, bad in { 0, 3, 1.5, -1, "1", 0 / 0, math.huge } do
				t.eq(DialogueLogic.choice(Dialogue.abu_nadim, "offer", bad), nil, tostring(bad))
			end
			t.truthy(DialogueLogic.choice(Dialogue.abu_nadim, "offer", 1))
			t.eq(DialogueLogic.choice(Dialogue.abu_nadim, "nonexistent", 1), nil)
		end)
	end)

	t.describe("RateLimiter", function()
		t.it("allows a burst then throttles, then refills", function()
			local l = RateLimiter.new(3, 1)
			t.truthy(RateLimiter.allow(l, "p", 0))
			t.truthy(RateLimiter.allow(l, "p", 0))
			t.truthy(RateLimiter.allow(l, "p", 0))
			t.eq(RateLimiter.allow(l, "p", 0), false)
			t.truthy(RateLimiter.allow(l, "p", 1.01))
			t.truthy(RateLimiter.allow(l, "other", 0), "keys are independent")
		end)
	end)

	t.describe("Validate", function()
		t.it("identifiers", function()
			t.truthy(Validate.isIdentifier("tarboosh_red"))
			for _, bad in { "", "a b", "../x", 5, nil, string.rep("a", 65) } do
				t.eq(Validate.isIdentifier(bad), false, tostring(bad))
			end
		end)
	end)
end
