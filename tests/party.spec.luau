--!nocheck
-- Lobby parties (Play panel): membership, host hand-over, countdown rules, Next, enemy preview.

return function(t)
	local PartyLogic = t.logic("PartyLogic")
	local Modes = t.config("Modes")
	local Waves = t.config("Waves")

	t.describe("PartyLogic", function()
		t.it("creates with the host inside and a countdown", function()
			local p = PartyLogic.new(1, "ep1", "normal", "a", 100, 25)
			t.eq(#p.players, 1)
			t.eq(p.host, "a")
			t.eq(p.startAt, 125)
		end)

		t.it("joins up to max, rejects duplicates, and a full party starts soon", function()
			local p = PartyLogic.new(1, "ep1", "normal", "a", 100, 25)
			t.truthy(PartyLogic.join(p, "b", 3, 101, 5))
			local ok, err = PartyLogic.join(p, "b", 3, 101, 5)
			t.eq(ok, false)
			t.eq(err, "already")
			t.truthy(PartyLogic.join(p, "c", 3, 102, 5))
			t.eq(p.startAt, 107, "full party shortens the countdown")
			local ok2, err2 = PartyLogic.join(p, "d", 3, 103, 5)
			t.eq(ok2, false)
			t.eq(err2, "full")
		end)

		t.it("hands host to the next member and reports empty", function()
			local p = PartyLogic.new(1, "ep1", "normal", "a", 0, 25)
			PartyLogic.join(p, "b", 4, 0, 5)
			t.eq(PartyLogic.leave(p, "a"), false)
			t.eq(p.host, "b")
			t.eq(PartyLogic.leave(p, "b"), true)
			t.eq(p.host, nil)
		end)

		t.it("only the host can start early, never later than planned", function()
			local p = PartyLogic.new(1, "ep1", "normal", "a", 0, 25)
			PartyLogic.join(p, "b", 4, 0, 5)
			t.eq(PartyLogic.startSoon(p, "b", 10, 3), false)
			t.eq(p.startAt, 25)
			t.truthy(PartyLogic.startSoon(p, "a", 10, 3))
			t.eq(p.startAt, 13)
			PartyLogic.startSoon(p, "a", 24, 3)
			t.eq(p.startAt, 13)
		end)

		t.it("Next follows the story chain and stops at the end", function()
			t.eq(PartyLogic.nextMode(Modes, "ep1"), "ep2")
			t.eq(PartyLogic.nextMode(Modes, "ep2"), "ep3")
			t.eq(PartyLogic.nextMode(Modes, "ep3"), "ep4", "Season Story 1 continues the chain")
			t.eq(PartyLogic.nextMode(Modes, "ep5"), "ep6")
			t.eq(PartyLogic.nextMode(Modes, "ep6"), "ep7")
			t.eq(PartyLogic.nextMode(Modes, "ep8"), "ep9")
			t.eq(PartyLogic.nextMode(Modes, "ep9"), nil, "the season ends at Episode 9")
			t.eq(PartyLogic.nextMode(Modes, "infinite"), nil)
		end)

		t.it("previews enemies in order of appearance and bosses by wave", function()
			local pool, bosses = PartyLogic.enemiesOf(Modes.ep1, Waves)
			t.eq(pool[1], "gendarme")
			t.eq(pool[2], "thief")
			t.eq(#pool, 4)
			t.eq(bosses[1], "sergeant")
			t.eq(bosses[2], "chief_thief")
			local _, endless = PartyLogic.enemiesOf(Modes.infinite, Waves)
			t.eq(#endless, 4)
		end)
	end)
end
