	["story.ep1.title"] = "Night of the Thieves",
	["story.ep1.intro.1"] = "Gather round. In the lane of jasmine, the cloth merchant's gold vanished in one night.",
	["story.ep1.intro.2"] = "The watchman saw a shadow at the gate, lifted his lantern… and was never seen again.",
	["story.ep1.intro.3"] = "Tonight the thieves come back for more. Hold the gate until dawn.",
	["story.ep1.outro.1"] = "Dawn came, and the gate still stood.",
	["story.ep1.outro.2"] = "The gold was gone, and so was the watchman. Only his lantern lay in the dust.",
	["story.ep1.outro.3"] = "And one man in the lane slept badly that night. Remember him.",
	["story.ep2.title"] = "The Rival Lane",
	["story.ep2.intro.1"] = "A man with a heavy secret moved his family to the next lane.",
	["story.ep2.intro.2"] = "There he whispered in their 'akeed's ear: \"Jasmine Lane thinks it is better than you.\"",
	["story.ep2.intro.3"] = "Now their thugs march on our gate, and their 'akeed walks behind them.",
	["story.ep2.outro.1"] = "The rival lane's men limped home, and their 'akeed swore he would return.",
	["story.ep2.outro.2"] = "Nobody asked who had lit the fire between the two lanes.",
	["story.ep2.outro.3"] = "Nobody, except the Hakawati. Come back tomorrow.",
	["story.ep3.title"] = "The Siege",
	["story.ep3.intro.1"] = "The noise of the feud reached the garrison on the hill.",
	["story.ep3.intro.2"] = "The commandant said: \"If the lanes cannot keep order, my soldiers will.\"",
	["story.ep3.intro.3"] = "Sappers at the walls, riders at the gate. This is a siege.",
	["story.ep3.outro.1"] = "The commandant rode away, his boots heavy with our mud.",
	["story.ep3.outro.2"] = "The lane counted its doors, its jars and its children. All there.",
	["story.ep3.outro.3"] = "But the gold of the first night was still missing. Patience.",
	["story.ep4.title"] = "The Lost Shoe",
	["story.ep4.intro.1"] = "Pickpockets poured into the square like sparrows, and the drums came after them.",
	["story.ep4.intro.2"] = "The gendarmes came too, searching every house for the stolen gold.",
	["story.ep4.intro.3"] = "Hold the square. Somewhere in this lane, a shoe is waiting to be found.",
	["story.ep4.outro.1"] = "Under a chest in a dark room, they found one old shoe.",
	["story.ep4.outro.2"] = "Its twin had been lost at the gate on the night of the gold.",
	["story.ep4.outro.3"] = "The sergeant shouted and threatened, but its owner said nothing at all.",
	["story.ep5.title"] = "Fire at the Warehouse",
	["story.ep5.intro.1"] = "The 'akeed needed a night guard for his warehouse, and he chose the man nobody trusted.",
	["story.ep5.intro.2"] = "That same night, torches moved through the orchards toward the door.",
	["story.ep5.intro.3"] = "Keep water ready. If the door burns, the harvest burns with it.",
	["story.ep5.outro.1"] = "The cleaver man was caught with the oil jar still in his hand.",
	["story.ep5.outro.2"] = "In the morning the 'akeed paid the night guard one gold lira.",
	["story.ep5.outro.3"] = "The first honest coin of his life. He held it and wept.",
	["story.ep6.title"] = "The Blind Beggar",
	["story.ep6.intro.1"] = "Fog sat on the square, and a blind beggar sat by the courtyard wall.",
	["story.ep6.intro.2"] = "He heard everything. And he saw, the Hakawati says, a little too much.",
	["story.ep6.intro.3"] = "Tonight some neighbours in the lane are not neighbours at all. Lanterns up.",
	["story.ep6.outro.1"] = "The beggar tore off his blindfold and ran, but the lanterns had seen his face.",
	["story.ep6.outro.2"] = "At the gate they found the purse he had taken, still full.",
	["story.ep6.outro.3"] = "The lane learned a hard lesson: not every quiet man is harmless.",
	["story.ep7.title"] = "The Police Post",
	["story.ep7.intro.1"] = "The sergeant lost his prisoner, and the corporal lost his rifle.",
	["story.ep7.intro.2"] = "Ashamed, the whole post marched on the lane to win back its pride.",
	["story.ep7.intro.3"] = "Riflemen will try to pin your defenders down. Spread them out.",
	["story.ep7.outro.1"] = "The commandant counted his men and found fewer than he had brought.",
	["story.ep7.outro.2"] = "The corporal's rifle turned up in a cooking pot. Nobody owned up.",
	["story.ep7.outro.3"] = "The post went quiet. But the rival lane had been watching.",
	["story.ep8.title"] = "The Two Lanes",
	["story.ep8.intro.1"] = "Two roads, two gates, and every man of the rival lane on them.",
	["story.ep8.intro.2"] = "Their 'akeed has stopped smiling. This time he comes himself.",
	["story.ep8.intro.3"] = "And somewhere among them walks the thief who started it all.",
	["story.ep8.outro.1"] = "At our gate the thief stopped, looked back at our lane, and turned his back on theirs.",
	["story.ep8.outro.2"] = "He fought beside us to the last wave. The lane called him a hero.",
	["story.ep8.outro.3"] = "Only he knew how heavy that word was. One tale is left.",
	["story.ep9.title"] = "The Confession",
	["story.ep9.intro.1"] = "His arm is gone and his nights are full of bad dreams. Still, he guards the gate.",
	["story.ep9.intro.2"] = "Snakes crawl out of a grave that only he knows about.",
	["story.ep9.intro.3"] = "Stand with him until dawn. He has something to say before the end.",
	["story.ep9.outro.1"] = "Before the elders he told the truth: the gold, the watchman, the night at the gate.",
	["story.ep9.outro.2"] = "Half the gold went to the lane, and half to the watchman's family.",
	["story.ep9.outro.3"] = "And the lane forgave him. So ends the tale of the Night Guard.",
	["story.boss.sergeant"] = "The sergeant swaggers in. He was never any good at catching thieves.",
	["story.boss.chief_thief"] = "Look who walks with the thieves tonight. Keep your eyes on his feet.",
	["story.boss.rival_zaim"] = "The rival lane's 'akeed comes to settle the score.",
	["story.boss.colonel"] = "The commandant, at last. He has never lost a siege… until tonight?",
	["story.boss.corporal"] = "Here comes the corporal, holding his rifle the wrong way round.",
	["story.boss.abu_jawdan"] = "The sergeant of four lanes. He wants a confession, any confession.",
	["story.boss.abu_shatour"] = "The cleaver man and his torch. Mind the door!",
	["story.boss.lateef"] = "The blind beggar opens his eyes. Watch him: he jumps.",
	["story.boss.spy"] = "Something moves in the shadows by the wall. Light it up.",
	["story.boss.fakhr"] = "One hand, one club, and a long grudge.",
	["story.boss.abu_zira"] = "He reels like a ship in a storm, and hits like one too.",
	["story.boss.rival_zaim_enraged"] = "The rival 'akeed is furious now, and his men close in around him.",
	["story.moment.ally_turn"] = "The thief reaches our gate… and turns to face his own lane.",

