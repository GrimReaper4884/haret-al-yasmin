--!strict
-- Plays the baked signature clips (Anim/Clips/<id>, generated by tools/anim/bake.py from Meshy
-- library actions) on an imported character by writing Bone.Transform on the client.
--
-- Why not Animator tracks: every clip would need publishing through Studio's Clip Editor, so all
-- 21 characters had shared one generic idle + one generic attack. Baked data needs no upload,
-- gives each character its own moves (Abu Hatem's tea-glass throw, Abu Shehab's shibriyeh…), and
-- lets the client time effects on the clip's impact frame and match walk speed to the path speed.
--
-- Clip format (per character module): `bones` = bone names; per slot (idle / walk / attack /
-- ability / hit): `frames`, `fps`, `rot` = base64 int16 x,y,z quaternions (w ≥ 0) per frame per
-- bone, `hips` = root offset per frame (rig units), `move` = forward speed of the source clip (rig
-- units / s), `hit` = impact frame (attack slots). Each character's clips decode once and are
-- shared by every copy of that character.

local HandProps = require(script.Parent.HandProps)

local BoneAnim = {}

export type Clip = {
	frames: number,
	fps: number,
	rots: { { CFrame } }, -- rots[frame][bone]
	hips: { Vector3 },
	move: number,
	hit: number?,
}

export type Player = {
	bones: { Bone },
	hipsRest: CFrame, -- rotation part of the Hips rest CFrame (for turning the whole body)
	scale: number,
	clips: { [string]: Clip },
	loop: Clip?,
	loopName: string?,
	loopT: number, -- frame position
	loopSpeed: number,
	shot: Clip?,
	shotT: number,
	shotSpeed: number,
	shotWeight: number,
	shotHold: boolean, -- keep the shot's last frame when it ends (death falls)
	slowUntil: number, -- os.clock() until which time runs at slowFactor (hit-stop, slow-in)
	slowFactor: number,
	yaw: number, -- radians, whole-body turn about the vertical
	id: string,
	props: { HandProps.Prop }, -- held items following the hands (Anim/HandProps)
}

local folder = script.Parent:WaitForChild("Clips")
local cache: { [string]: { [string]: Clip } | false } = {}

---------------------------------------------------------------- decoding

local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local VAL: { [number]: number } = {}
for i = 1, 64 do
	VAL[string.byte(B64, i)] = i - 1
end

local function decode64(s: string): buffer
	local n = #s
	local pad = if string.sub(s, -2) == "==" then 2 elseif string.sub(s, -1) == "=" then 1 else 0
	local len = (n // 4) * 3 - pad
	local out = buffer.create(len)
	local o = 0
	for i = 1, n, 4 do
		local a, b, c, d = string.byte(s, i, i + 3)
		local v = VAL[a] * 262144 + VAL[b] * 4096 + (VAL[c :: number] or 0) * 64 + (VAL[d :: number] or 0)
		buffer.writeu8(out, o, v // 65536)
		if o + 1 < len then
			buffer.writeu8(out, o + 1, (v // 256) % 256)
		end
		if o + 2 < len then
			buffer.writeu8(out, o + 2, v % 256)
		end
		o += 3
	end
	return out
end

local function decodeClip(raw: any, nb: number): Clip
	local buf = decode64(raw.rot)
	local rots = table.create(raw.frames)
	local k = 0
	for f = 1, raw.frames do
		local row = table.create(nb)
		for b = 1, nb do
			local x = buffer.readi16(buf, k) / 32767
			local y = buffer.readi16(buf, k + 2) / 32767
			local z = buffer.readi16(buf, k + 4) / 32767
			k += 6
			local w = math.sqrt(math.max(0, 1 - x * x - y * y - z * z))
			row[b] = CFrame.new(0, 0, 0, x, y, z, w)
		end
		rots[f] = row
	end
	local hips = table.create(raw.frames)
	for f, h in raw.hips do
		hips[f] = Vector3.new(h[1], h[2], h[3])
	end
	return { frames = raw.frames, fps = raw.fps, rots = rots, hips = hips, move = raw.move or 0, hit = raw.hit }
end

local function clipsFor(id: string): ({ [string]: Clip }?, any)
	local mod = folder:FindFirstChild(id)
	if not mod or not mod:IsA("ModuleScript") then
		return nil, nil
	end
	local raw = require(mod) :: any
	local got = cache[id]
	if got == nil then
		local set = {}
		for slot, data in raw do
			if type(data) == "table" and data.rot then
				set[slot] = decodeClip(data, #raw.bones)
			end
		end
		cache[id] = set
		got = set
	end
	return if type(got) == "table" then got else nil, raw
end

---------------------------------------------------------------- players

-- True when baked clips exist for this character id.
function BoneAnim.has(id: string?): boolean
	return id ~= nil and folder:FindFirstChild(id) ~= nil
end

-- Binds a player to an imported model (Bones under its MeshPart). nil when the model has no
-- matching skeleton or no baked clips.
function BoneAnim.new(model: Model, id: string): Player?
	local clips, raw = clipsFor(id)
	if not clips or not raw then
		return nil
	end
	local names: { string } = raw.bones
	local byName: { [string]: Bone } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Bone") then
			byName[d.Name] = d
		end
	end
	local bones = table.create(#names)
	for i, n in names do
		local b = byName[n]
		if not b then
			if i == 1 then
				return nil -- no Hips, no figure to move
			end
			-- A bone the importer left out (it carried no skin weight: Al-Adashari's cut-off left hand,
			-- S1-A05): an unparented stand-in takes its writes.
			b = Instance.new("Bone")
		end
		bones[i] = b
	end
	local hips = bones[1]
	local props = HandProps.attach(model, id, byName)
	local shin = byName.LeftLeg
	local scale = if shin and raw.ref and raw.ref > 0 then shin.CFrame.Position.Magnitude / raw.ref else model:GetScale()
	return {
		bones = bones,
		hipsRest = hips.CFrame.Rotation,
		scale = scale,
		clips = clips,
		loop = nil,
		loopName = nil,
		loopT = math.random() * 10,
		loopSpeed = 1,
		shot = nil,
		shotT = 0,
		shotSpeed = 1,
		shotWeight = 1,
		shotHold = false,
		slowUntil = 0,
		slowFactor = 1,
		yaw = 0,
		id = id,
		props = props,
	}
end

-- Gives this figure another character's clip for `slot` (a lane NPC wearing a unit's model walks
-- with an enemy's walk, LP-D02). Every Meshy rig shares one skeleton; the clip is remapped by bone
-- name when the lists differ. False when `fromId` has no such clip.
function BoneAnim.borrow(p: Player, fromId: string, slot: string): boolean
	local set, raw = clipsFor(fromId)
	local c = set and set[slot]
	local _, own = clipsFor(p.id)
	if not c or not raw or not own then
		return false
	end
	local same = #raw.bones == #own.bones
	if same then
		for i, n in own.bones do
			if raw.bones[i] ~= n then
				same = false
				break
			end
		end
	end
	if not same then
		local at: { [string]: number } = {}
		for i, n in raw.bones do
			at[n] = i
		end
		local rots = table.create(c.frames)
		for f, row in c.rots do
			local out = table.create(#own.bones)
			for i, n in own.bones do
				local k = at[n]
				out[i] = if k then row[k] else CFrame.identity
			end
			rots[f] = out
		end
		c = { frames = c.frames, fps = c.fps, rots = rots, hips = c.hips, move = c.move, hit = c.hit }
	end
	p.clips = table.clone(p.clips) -- the decoded set is shared by every copy of this character
	p.clips[slot] = c
	if p.loopName == slot or (slot == "idle" and p.loopName == nil) then
		p.loop = nil -- re-pick on the next loop()
	end
	return true
end

-- Sets the looping clip ("idle" / "walk"); keeps its place if it is already playing.
function BoneAnim.loop(p: Player, slot: string, speed: number?)
	local c = p.clips[slot] or p.clips.idle or p.clips.walk
	if c and c ~= p.loop then
		p.loop = c
		p.loopName = slot
		p.loopT = math.random() * (c.frames - 1)
	end
	p.loopSpeed = speed or 1
end

-- Plays a one-shot clip over the loop. Returns the seconds until its impact frame (0 if none), or
-- nil when this character has no such clip. `weight` < 1 layers it partially (hit reactions);
-- `hold` keeps the last frame instead of fading back to the loop (a death fall).
function BoneAnim.play(p: Player, slot: string, speed: number?, weight: number?, hold: boolean?): number?
	local c = p.clips[slot]
	if not c then
		return nil
	end
	p.shot = c
	p.shotT = 0
	p.shotSpeed = speed or 1
	p.shotWeight = weight or 1
	p.shotHold = hold == true
	return (c.hit or 0) / (c.fps * p.shotSpeed)
end

-- Runs this figure's clips at `factor` for `seconds` (0 = a hit-stop freeze, 0.4 = a slow-in).
function BoneAnim.slow(p: Player, factor: number, seconds: number)
	p.slowFactor = factor
	p.slowUntil = os.clock() + seconds
end

function BoneAnim.busy(p: Player): boolean
	return p.shot ~= nil
end

-- Clip length in seconds at normal speed (0 when missing).
function BoneAnim.length(p: Player, slot: string): number
	local c = p.clips[slot]
	return if c then (c.frames - 1) / c.fps else 0
end

-- Forward speed (studs / s) the walk clip was authored at, for this model's scale.
function BoneAnim.walkSpeed(p: Player): number
	local c = p.clips.walk
	return if c then c.move * p.scale else 0
end

local FADE_IN, FADE_OUT = 0.06, 0.16 -- seconds

-- Advances and writes the pose. `smooth` = interpolate between baked frames (near figures).
function BoneAnim.step(p: Player, dt: number, smooth: boolean)
	local loop = p.loop
	if not loop then
		return
	end
	if p.slowUntil > 0 then
		if os.clock() < p.slowUntil then
			dt *= p.slowFactor
		else
			p.slowUntil = 0
		end
	end
	local last = loop.frames - 1
	p.loopT = (p.loopT + dt * p.loopSpeed * loop.fps) % last
	local lt = p.loopT
	local li = math.floor(lt)
	local la = lt - li
	local l0, l1 = loop.rots[li + 1], loop.rots[math.min(li + 2, loop.frames)]
	local hips = if smooth then loop.hips[li + 1]:Lerp(loop.hips[math.min(li + 2, loop.frames)], la) else loop.hips[li + 1]

	local w = 0
	local s0, s1, sa = l0, l1, 0
	local shot = p.shot
	if shot then
		p.shotT += dt * p.shotSpeed * shot.fps
		local sl = shot.frames - 1
		if p.shotT >= sl and p.shotHold then
			p.shotT = sl
		end
		if p.shotT >= sl and not p.shotHold then
			p.shot = nil
		else
			local secIn = p.shotT / (shot.fps * p.shotSpeed)
			local secOut = if p.shotHold then math.huge else (sl - p.shotT) / (shot.fps * p.shotSpeed)
			w = math.min(1, secIn / FADE_IN, secOut / FADE_OUT) * p.shotWeight
			local si = math.floor(p.shotT)
			sa = p.shotT - si
			s0, s1 = shot.rots[si + 1], shot.rots[math.min(si + 2, shot.frames)]
			local sh = shot.hips[si + 1]:Lerp(shot.hips[math.min(si + 2, shot.frames)], sa)
			hips = hips:Lerp(sh, w)
		end
	end

	local bones = p.bones
	for b = 1, #bones do
		local cf = if smooth then l0[b]:Lerp(l1[b], la) else l0[b]
		if w > 0 then
			local sc = if smooth then s0[b]:Lerp(s1[b], sa) else s0[b]
			cf = cf:Lerp(sc, w)
		end
		if b == 1 then
			cf = cf + hips * p.scale
			if p.yaw ~= 0 then
				-- Turn about the model's vertical, expressed in the Hips' own frame.
				local r = p.hipsRest
				cf = r:Inverse() * CFrame.Angles(0, p.yaw, 0) * r * cf
			end
		end
		bones[b].Transform = cf
	end
	if #p.props > 0 then
		HandProps.update(p.props, os.clock())
	end
end

-- The prop thrown on `slot` leaves the hand for a moment (it reappears: "grabs another").
function BoneAnim.thrown(p: Player, slot: string, seconds: number)
	HandProps.thrown(p.props, p.id, slot, seconds)
end

-- Static pose (first frame of a slot), e.g. for card previews.
function BoneAnim.pose(p: Player, slot: string)
	local c = p.clips[slot]
	if not c then
		return
	end
	for b, bone in p.bones do
		local cf = c.rots[1][b]
		if b == 1 then
			cf = cf + c.hips[1] * p.scale
		end
		bone.Transform = cf
	end
	if #p.props > 0 then
		HandProps.update(p.props, os.clock())
	end
end

return BoneAnim
